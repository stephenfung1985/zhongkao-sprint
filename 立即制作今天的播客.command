#!/bin/bash
# 中考三十分钟电台 — macOS 手动补做今天这一期
# 正常情况下不用点：每天下午 5 点会自动做好。这个是补做用的 ——
# 比如那会儿电脑关着、或者没联网。
# 合成需要联网，大约 3 到 8 分钟。做好之前别关这个窗口。
# 对应 Windows 的「立即制作今天的播客.bat」。

cd "$(dirname "$0")" || exit 1

PY=""
if command -v python3 >/dev/null 2>&1; then
  PY="python3"
fi

echo ""
echo "============================================================"
echo "   中考三十分钟电台 - 手动制作今天这一期"
echo "============================================================"
echo ""

if [ -z "$PY" ]; then
  echo "  没有找到 Python3。请先安装（https://www.python.org/downloads/），"
  echo "  再重新双击本文件。"
  echo ""
  read -r -p "  按回车键关闭…" _
  exit 1
fi

echo "   合成需要联网，大约 3 到 8 分钟。做好之前别关这个窗口。"
echo ""
echo "------------------------------------------------------------"
echo ""

"$PY" "播客/每日任务.py"
CODE=$?

echo ""
echo "------------------------------------------------------------"
if [ "$CODE" = "0" ]; then
  echo "   做好了。打开学习平台，点顶部的「播客」就能放。"
else
  echo "   没做成。上面的提示写了卡在哪儿，"
  echo "   详细记录在：播客/日志.txt"
fi
echo ""
read -r -p "   按回车键关闭…" _
