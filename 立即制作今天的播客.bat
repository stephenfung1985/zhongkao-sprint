@echo off
chcp 65001 >nul
cd /d "%~dp0"
title 制作今天的播客

echo.
echo ============================================================
echo   中考三十分钟电台 - 手动制作今天这一期
echo ============================================================
echo.
echo   正常情况下不用点这个：每天下午 5 点会自动做好。
echo   这个是补做用的 —— 比如那会儿电脑关着、或者没联网。
echo.
echo   合成需要联网，大约 3 到 8 分钟。做好之前别关这个窗口。
echo.

python "播客\每日任务.py"
set CODE=%ERRORLEVEL%

echo.
if "%CODE%"=="0" (
  echo   ------------------------------------------------------------
  echo   做好了。打开学习平台，点顶部的「播客」就能放。
  echo   ------------------------------------------------------------
) else (
  echo   ------------------------------------------------------------
  echo   没做成。上面的提示写了卡在哪儿，
  echo   详细记录在：播客\日志.txt
  echo   ------------------------------------------------------------
)
echo.
pause
